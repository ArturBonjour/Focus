# ── Docker Compose env vars ────────────────────────────────────────────────────
# Copy to .env and fill in secrets before running docker-compose up

# JWT secrets — change these to random 256-bit strings in production!
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# Public URL of the frontend (used by backend CORS)
FRONTEND_URL=http://localhost:3000

# Public API URL (used by Next.js client-side fetch)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
